# Copy to .env on the server (chmod 600); never commit real credentials.
# Pin a verified image by commit SHA, rather than using the moving :vps tag.
APP_IMAGE=ghcr.io/ivzaislu/ha-angebote-checker:REPLACE_WITH_VERIFIED_COMMIT_SHA
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
APP_PORT=8080
# Owner key for the optional training button (at least 24 characters).
# Generate on your server: openssl rand -hex 24
TRAINING_ADMIN_TOKEN=
